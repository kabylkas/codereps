FROM python:3.12-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends gcc libc6-dev \
    && rm -rf /var/lib/apt/lists/*

# Defense-in-depth: the root fs is mounted read-only at run time, but scrub the
# package manager anyway so a container that somehow gains write access still
# cannot fetch anything. (--network none already blocks egress.)
RUN rm -rf /etc/apt/sources.list /etc/apt/sources.list.d/* /var/lib/apt/lists/* \
    && rm -f /usr/bin/apt /usr/bin/apt-get /usr/bin/apt-cache /usr/bin/dpkg-deb

WORKDIR /work

# Default user is overridden at run time with --user 65534:65534 (nobody:nogroup)
USER 65534:65534
