FROM python:3.12-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends gcc libc6-dev \
    && rm -rf /var/lib/apt/lists/*

# Drop capability to install or modify packages — image is read-only at runtime,
# but defense-in-depth: scrub package manager state.
RUN apt-get purge -y --auto-remove apt-listchanges \
    && rm -rf /etc/apt/sources.list.d/*

WORKDIR /work

# Default user is overridden at run time with --user 65534:65534 (nobody:nogroup)
USER 65534:65534
