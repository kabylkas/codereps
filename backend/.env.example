# --- Required ---
# Generated for local dev. Rotate for any shared/deployed environment.
SECRET_KEY=replace-me-run: python3 -c "import secrets; print(secrets.token_urlsafe(48))"

# --- Database ---
DATABASE_URL=sqlite+aiosqlite:///./codereps.db

# --- Auth ---
ALGORITHM=HS256
# 8 hours: long enough to step away mid-problem without being logged out.
# There is no refresh endpoint and tokens cannot be revoked (REVIEW.md F9),
# so shorten this before any real deployment.
ACCESS_TOKEN_EXPIRE_MINUTES=480

# --- LLM (OpenRouter) ---
# Required for AI problem generation + student personalization.
# Get a key at https://openrouter.ai/keys — leave blank to run without AI features.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
MODEL_PROBLEM=google/gemini-2.5-flash-lite
MODEL_CODE=xiaomi/mimo-v2-pro
